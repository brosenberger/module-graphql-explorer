<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="admin-1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="BroCode_GraphQlExplorer::vendor/graphiql.css"/>
        <css src="BroCode_GraphQlExplorer::css/explorer.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template"
                   name="brocode.graphqlexplorer"
                   template="BroCode_GraphQlExplorer::explorer.phtml">
                <arguments>
                    <argument name="explorer_config" xsi:type="object">
                        BroCode\GraphQlExplorer\ViewModel\ExplorerConfig
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
