<?php
/**
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \BroCode\GraphQlExplorer\ViewModel\ExplorerConfig $config
 */
$config = $block->getData('explorer_config');
$stores = $config->getStoreOptions();
?>
<div class="brocode-gqle">
    <div class="brocode-gqle__bar">
        <label class="brocode-gqle__label" for="brocode-gqle-store">
            <?= $escaper->escapeHtml(__('Store view')) ?>
        </label>
        <select id="brocode-gqle-store" class="brocode-gqle__select">
            <?php foreach ($stores as $store): ?>
                <option value="<?= $escaper->escapeHtmlAttr($store['code']) ?>">
                    <?= $escaper->escapeHtml($store['label']) ?>
                </option>
            <?php endforeach; ?>
        </select>

        <label class="brocode-gqle__label" for="brocode-gqle-token">
            <?= $escaper->escapeHtml(__('Customer token (optional)')) ?>
        </label>
        <input type="text"
               id="brocode-gqle-token"
               class="brocode-gqle__input"
               autocomplete="off"
               spellcheck="false"
               placeholder="<?= $escaper->escapeHtmlAttr(__('Bearer token from generateCustomerToken')) ?>"/>

        <span class="brocode-gqle__hint">
            <?= $escaper->escapeHtml(
                __('Queries run against the selected store view via the Store header. Leave the token empty to query as a guest.')
            ) ?>
        </span>
    </div>

    <div id="brocode-gqle-root"
         class="brocode-gqle__root"
         data-gqle-config="<?= $escaper->escapeHtmlAttr($config->getJsonConfig()) ?>"></div>
</div>

<script type="text/x-magento-init">
{
    "#brocode-gqle-root": {
        "BroCode_GraphQlExplorer/js/explorer": {}
    }
}
</script>
