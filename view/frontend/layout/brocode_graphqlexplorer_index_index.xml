<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="BroCode_GraphQlExplorer::vendor/graphiql.css"/>
        <css src="BroCode_GraphQlExplorer::css/explorer.css"/>
        <meta name="robots" content="NOINDEX,NOFOLLOW"/>
    </head>
    <body>
        <referenceContainer name="content">
            <!--
                cacheable="false" is load-bearing, not hygiene. Without it the
                full page cache stores the authorised response and then serves
                it to anonymous visitors, which silently defeats Basic Auth.
            -->
            <block class="Magento\Framework\View\Element\Template"
                   name="brocode.graphqlexplorer"
                   cacheable="false"
                   template="BroCode_GraphQlExplorer::explorer.phtml">
                <arguments>
                    <argument name="explorer_config" xsi:type="object">
                        BroCode\GraphQlExplorer\ViewModel\ExplorerConfig
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
